{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OCard",
  "version": "0.1.0",
  "identifier": "com.ocard.dit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OCard - DIT 素材管理",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "DIT 素材备份管理工具",
    "longDescription": "OCard - 跨平台 DIT 素材备份管理工具：插卡拷卡、HASH 校验、分类选片、转码与交付打包。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
